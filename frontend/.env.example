# Frontend Public Configuration (Vercel / Local)
# For local dev: leave VITE_API_BASE_URL=/api and VITE_HARDHAT_RPC_URL=http://127.0.0.1:8545
# For Vercel production: set VITE_API_BASE_URL=https://<your-backend>.onrender.com/api
# and VITE_HARDHAT_RPC_URL=https://<your-contracts>.onrender.com
VITE_API_BASE_URL=/api
VITE_HARDHAT_RPC_URL=http://127.0.0.1:8545
VITE_ENABLE_LOCAL_CHAIN=true
VITE_SEPOLIA_RPC_URL=
